@model IEnumerable<InventarioApp.Models.Activo>
@{ ViewBag.Title = "Activos"; }

<h2>Activos</h2>
<a href="@Url.Action("Create")" class="btn btn-primary mb-3">+ Nuevo activo</a>

<table class="table table-striped table-sm">
    <thead>
        <tr><th>Código</th><th>Nombre</th><th>Categoría</th><th>Marca/Modelo</th><th>Estado</th><th>Ubicación</th><th>Responsable</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Codigo</td>
                <td>@a.Nombre</td>
                <td>@a.NombreCategoria</td>
                <td>@a.NombreMarca @a.NombreModelo</td>
                <td>@a.NombreEstado</td>
                <td>@a.NombreUbicacionActual</td>
                <td>@a.NombreResponsable</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = a.Id })" class="btn btn-sm btn-outline-secondary">Editar</a>
                    @using (Html.BeginForm("Delete", "Activos", FormMethod.Post, new { onsubmit = "return confirm('¿Eliminar este activo?');", style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@a.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
