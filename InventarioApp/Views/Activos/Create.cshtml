@model InventarioApp.Models.Activo

@{
    ViewBag.Title = "Nuevo activo";
    ViewBag.EsCreacion = true;

    if (Request.IsAjaxRequest()) { Layout = null; }
}

<div class="modal-header">
    <div>
        <h5 class="modal-title">Nuevo activo</h5>
        <div class="text-muted-sm">Los campos con ⓘ tienen una nota sobre para qué sirven.</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>

@using (Html.BeginForm("Create", "Activos", FormMethod.Post, new { id = "activoForm" }))
{
    @Html.AntiForgeryToken()

    @Html.Partial("_ActivoFormCard", Model ?? new InventarioApp.Models.Activo())

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar activo</button>
    </div>
}
