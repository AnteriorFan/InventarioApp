@model InventarioApp.Models.Item

@{
    ViewBag.Title = "Nuevo Item";
}

<h2>Nuevo Item</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div>@Html.LabelFor(m => m.Codigo) @Html.TextBoxFor(m => m.Codigo)</div>
    <div>@Html.LabelFor(m => m.Nombre) @Html.TextBoxFor(m => m.Nombre)</div>
    <div>@Html.LabelFor(m => m.Descripcion) @Html.TextBoxFor(m => m.Descripcion)</div>
    <div>@Html.LabelFor(m => m.IdCategoria) @Html.TextBoxFor(m => m.IdCategoria)</div>
    <div>@Html.LabelFor(m => m.Cantidad) @Html.TextBoxFor(m => m.Cantidad)</div>
    <div>@Html.LabelFor(m => m.UnidadMedida) @Html.TextBoxFor(m => m.UnidadMedida)</div>
    <div>@Html.LabelFor(m => m.Ubicacion) @Html.TextBoxFor(m => m.Ubicacion)</div>

    <button type="submit">Guardar</button>
}
