@model InventarioApp.Models.Item

@{
    ViewBag.Title = "Nuevo item";
    ViewBag.EsCreacion = true;

    // Cargada por AJAX dentro del modal -> sin layout, para no meter el navbar
    // y el footer completos adentro de la ventana.
    if (Request.IsAjaxRequest()) { Layout = null; }
}

<div class="modal-header">
    <div>
        <h5 class="modal-title">Nuevo item</h5>
        <div class="text-muted-sm">Los campos con ⓘ tienen una nota sobre para qué sirven.</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>

@using (Html.BeginForm("Create", "Items", FormMethod.Post, new { id = "itemForm", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.Partial("_ItemFormCard", Model ?? new InventarioApp.Models.Item { StockMinimo = 5 })

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar item</button>
    </div>
}
