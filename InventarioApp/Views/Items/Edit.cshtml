@model InventarioApp.Models.Item

@{
    ViewBag.Title = "Modificar item";
    ViewBag.EsCreacion = false;

    if (Request.IsAjaxRequest()) { Layout = null; }
}

<div class="modal-header">
    <div>
        <h5 class="modal-title">Modificar item</h5>
        <div class="text-muted-sm">@Model.Nombre <span class="badge-codigo ms-1">@Model.Codigo</span></div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>

@using (Html.BeginForm("Edit", "Items", FormMethod.Post, new { id = "itemForm", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    @Html.Partial("_ItemFormCard", Model)

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
}
