@model IEnumerable<InventarioApp.Models.Item>

@{
    ViewBag.Title = "Items";
}

<h2>Items en inventario</h2>
<a href="@Url.Action("Create")">+ Nuevo item</a>

<table class="table">
    <thead>
        <tr><th>Código</th><th>Nombre</th><th>Cantidad</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Nombre</td>
                <td>@item.Cantidad</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = item.Id })">Editar</a>

                    @using (Html.BeginForm("Delete", "Items", FormMethod.Post, new { onsubmit = "return confirm('¿Seguro que quieres eliminar este item?');", style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit">Eliminar</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
