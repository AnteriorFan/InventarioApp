@model IEnumerable<InventarioApp.Models.Modelo>
@{ ViewBag.Title = "Modelos"; }

<h2>Modelos</h2>
@if (Html.TienePermiso("CATALOGOS_ADMINISTRAR"))
{
    <a href="@Url.Action("Create")" class="btn btn-primary mb-3">+ Nuevo modelo</a>
}

<table class="table table-striped">
    <thead><tr><th>Marca</th><th>Nombre</th><th>Descripción</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.NombreMarca</td>
                <td>@m.Nombre</td>
                <td>@m.Descripcion</td>
                <td>
                    @if (Html.TienePermiso("CATALOGOS_ADMINISTRAR"))
                    {
                        <a href="@Url.Action("Edit", new { id = m.Id })" class="btn btn-sm btn-outline-secondary">Editar</a>

                        using (Html.BeginForm("Delete", "Modelos", FormMethod.Post, new { onsubmit = "return confirm('¿Eliminar este modelo?');", style = "display:inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        }
                    }
                    else
                    {
                        <span class="text-muted-sm">—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
