@model IEnumerable<InventarioApp.Models.TipoMovimiento>
@{ ViewBag.Title = "Tipos de Movimiento"; }

<h2>Tipos de Movimiento</h2>
<a href="@Url.Action("Create")" class="btn btn-primary mb-3">+ Nuevo tipo</a>

<table class="table table-striped">
    <thead><tr><th>Nombre</th><th>Descripción</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Nombre</td>
                <td>@t.Descripcion</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = t.Id })" class="btn btn-sm btn-outline-secondary">Editar</a>
                    @using (Html.BeginForm("Delete", "TiposMovimiento", FormMethod.Post, new { onsubmit = "return confirm('¿Eliminar este tipo?');", style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
