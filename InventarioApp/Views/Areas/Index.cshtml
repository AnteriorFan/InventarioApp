@model IEnumerable<InventarioApp.Models.Area>
@{ ViewBag.Title = "Áreas"; }

<h2>Áreas</h2>
@if (Html.TienePermiso("UBICACIONES_ADMINISTRAR"))
{
    <a href="@Url.Action("Create")" class="btn btn-primary mb-3">+ Nueva área</a>
}

<table class="table table-striped">
    <thead><tr><th>Edificio</th><th>Nombre</th><th>Descripción</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.NombreEdificio</td>
                <td>@a.Nombre</td>
                <td>@a.Descripcion</td>
                <td>
                    @if (Html.TienePermiso("UBICACIONES_ADMINISTRAR"))
                    {
                        <a href="@Url.Action("Edit", new { id = a.Id })" class="btn btn-sm btn-outline-secondary">Editar</a>

                        using (Html.BeginForm("Delete", "Areas", FormMethod.Post, new { onsubmit = "return confirm('¿Eliminar esta área?');", style = "display:inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        }
                    }
                    else
                    {
                        <span class="text-muted-sm">—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
