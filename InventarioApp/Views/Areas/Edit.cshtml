@model InventarioApp.Models.Area
@{ ViewBag.Title = "Editar Area"; }

<h2>Editar Area</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="mb-3">
        @Html.Label("Edificio")
        @Html.DropDownList("IdEdificio", (SelectList)ViewBag.Edificios, "-- Selecciona edificio --", new { @class = "form-select" })
    </div>
    <div class="mb-3">@Html.LabelFor(m => m.Nombre) @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })</div>
    <div class="mb-3">@Html.LabelFor(m => m.Descripcion) @Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control" })</div>
    <button type="submit" class="btn btn-primary">Guardar</button>
}