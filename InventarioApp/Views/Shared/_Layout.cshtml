@{
    // Controller de la request actual. Sirve para marcar la seccion activa del
    // navbar: es dato de routing, no hay que pasarlo desde cada Controller.
    var controladorActual = ViewContext.RouteData.Values["controller"] as string ?? "";

    // Recibe los controllers de la seccion separados por "|" y devuelve la clase
    // del <a>. Los pipes de los extremos evitan falsos positivos: sin ellos,
    // "Items" haria match dentro de "TiposMovimiento".
    Func<string, string> activo = seccion =>
        ("|" + seccion + "|").IndexOf("|" + controladorActual + "|", StringComparison.OrdinalIgnoreCase) >= 0
            ? "nav-link active"
            : "nav-link";

    var nombreUsuario = Request.IsAuthenticated ? User.Identity.Name : "";
    var inicial = string.IsNullOrEmpty(nombreUsuario) ? "?" : nombreUsuario.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title &middot; Inventario</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                    <line x1="12" y1="22.08" x2="12" y2="12" />
                </svg>
                Inventario
            </a>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navPrincipal"
                    aria-controls="navPrincipal" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navPrincipal">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="@activo("Home")" href="@Url.Action("Index", "Home")">Inicio</a>
                    </li>
                    @*  Cada seccion se pinta solo si el usuario tiene el permiso
                        de VER correspondiente. Un EMPLEADO ya no ve menus que
                        lo unico que hacen es mandarlo a "No autorizado".

                        Esto NO es la seguridad: la seguridad es el
                        [AuthorizePermiso] del Controller. Aca solo se deja de
                        ofrecer lo que de todos modos no va a poder abrir. *@
                    <li class="nav-item">
                        <a class="@activo("Items|Movimientos")" href="@Url.Action("Index", "Items")">Items</a>
                    </li>

                    @if (Html.TienePermiso("ACTIVOS_VER"))
                    {
                        <li class="nav-item">
                            <a class="@activo("Activos")" href="@Url.Action("Index", "Activos")">Activos</a>
                        </li>
                    }

                    @if (Html.TienePermiso("UBICACIONES_VER"))
                    {
                        <li class="nav-item dropdown">
                            <a class="@activo("Edificios|Areas|Espacios") dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Ubicaciones</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Edificios")">Edificios</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Areas")">Áreas</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Espacios")">Espacios</a></li>
                            </ul>
                        </li>
                    }

                    @if (Html.TienePermiso("CATALOGOS_VER"))
                    {
                        <li class="nav-item dropdown">
                            <a class="@activo("Categorias|Marcas|Modelos|Estados|TiposMovimiento") dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Catálogos</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Categorias")">Categorías</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Marcas")">Marcas</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Modelos")">Modelos</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Estados")">Estados</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "TiposMovimiento")">Tipos de movimiento</a></li>
                            </ul>
                        </li>
                    }

                    @*  Esta seccion solo se PINTA si el usuario tiene el permiso.
                        No es la proteccion: la proteccion es el
                        [AuthorizePermiso("SEGURIDAD_ADMINISTRAR")] de los dos
                        Controllers. Esconderla aca solo evita ofrecerle a la
                        gente un menu que le va a mandar a "No autorizado". *@
                    @if (Html.TienePermiso("SEGURIDAD_ADMINISTRAR"))
                    {
                        <li class="nav-item dropdown">
                            <a class="@activo("Roles|Usuarios") dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Usuarios")">Usuarios</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Roles")">Roles y permisos</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="user-chip dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar">@inicial</span>
                                <span>@nombreUsuario</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="dropdown-header">Sesión iniciada como <strong>@nombreUsuario</strong></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Escaner")">Escanear código</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">Cerrar sesión</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Account")">Iniciar sesión</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @*  Un solo contenedor de avisos para toda la app.

            Antes habia dos caminos distintos: TempData["Error"] se pintaba aca
            y el mensaje de exito se armaba con HTML duplicado dentro del JS de
            Items/Index. Ahora los dos terminan en el mismo lugar, y el JS solo
            llama a mostrarFlash(). *@
        <div id="flashContainer">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Exito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
        </div>

        @RenderBody()

        <footer class="mt-5 pt-3 border-top">
            <p class="mb-0">&copy; @DateTime.Now.Year &middot; Sistema de inventario</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

    <script>
        // Helpers globales, disponibles en cualquier vista.

        // Pinta un aviso arriba del contenido.
        function mostrarFlash(mensaje, tipo) {
            var clase = (tipo === 'error') ? 'alert-danger' : 'alert-success';
            $('#flashContainer').html(
                '<div class="alert ' + clase + ' alert-dismissible fade show" role="alert">' +
                $('<div>').text(mensaje).html() +   // escapa el texto: nunca inyectar HTML sin filtrar
                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>' +
                '</div>'
            );
        }

        // Un mensaje guardado antes de un location.reload() sobrevive en
        // sessionStorage (una variable JS normal no: la recarga la borra).
        function mostrarFlashPendiente() {
            var msg = sessionStorage.getItem('flashMessage');
            if (msg) {
                mostrarFlash(msg, sessionStorage.getItem('flashTipo') || 'ok');
                sessionStorage.removeItem('flashMessage');
                sessionStorage.removeItem('flashTipo');
            }
        }

        function guardarFlashPendiente(mensaje, tipo) {
            sessionStorage.setItem('flashMessage', mensaje);
            sessionStorage.setItem('flashTipo', tipo || 'ok');
        }

        //  Buscador + paginacion para cualquier tabla marcada con la clase
        //  "tabla-buscable".
        //
        //  Vive aca y no repetido en cada vista a proposito: los nueve listados
        //  de catalogos necesitan exactamente la misma configuracion, y tener
        //  nueve copias del mismo DataTable() significa que cualquier ajuste hay
        //  que hacerlo nueve veces (y acordarse de las nueve).
        //
        //  Items y Activos NO llevan esta clase: tienen su propia inicializacion
        //  con opciones distintas. Si alguna vez se les pone, se inicializarian
        //  dos veces y DataTables se queja.
        function initTablasBuscables() {
            $('table.tabla-buscable').each(function () {
                $(this).DataTable({
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json' },
                    // La ultima columna siempre son los botones: ni se ordena ni se busca.
                    columnDefs: [{ targets: -1, orderable: false, searchable: false }],
                    order: [[0, 'asc']]
                });
            });
        }

        $(function () {
            mostrarFlashPendiente();
            initTablasBuscables();
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
