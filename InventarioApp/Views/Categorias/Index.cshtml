@model IEnumerable<InventarioApp.Models.Categoria>
@{ ViewBag.Title = "Categorías"; }

<h2>Categorías</h2>
@if (Html.TienePermiso("CATALOGOS_ADMINISTRAR"))
{
    <a href="@Url.Action("Create")" class="btn btn-primary mb-3">+ Nueva categoría</a>
}

<table class="table table-hover align-middle tabla-buscable">
    <thead><tr><th>Nombre</th><th>Abreviatura</th><th>Descripción</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nombre</td>
                <td>
                    @if (string.IsNullOrEmpty(c.Abreviatura))
                    {
                        <span class="badge bg-warning">falta</span>
                    }
                    else
                    {
                        <span class="mono">@c.Abreviatura</span>
                    }
                </td>
                <td>@c.Descripcion</td>
                <td>
                    @if (Html.TienePermiso("CATALOGOS_ADMINISTRAR"))
                    {
                        <a href="@Url.Action("Edit", new { id = c.Id })" class="btn btn-sm btn-outline-secondary">Editar</a>

                        using (Html.BeginForm("Delete", "Categorias", FormMethod.Post, new { onsubmit = "return confirm('¿Eliminar esta categoría?');", style = "display:inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        }
                    }
                    else
                    {
                        <span class="text-muted-sm">—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
