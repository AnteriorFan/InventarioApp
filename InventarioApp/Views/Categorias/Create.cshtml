@model InventarioApp.Models.Categoria
@{ ViewBag.Title = "Nueva Categoría"; }

<h2>Nueva Categoría</h2>
@using (Html.BeginForm("Create", "Categorias", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

    <div class="mb-3">
        @Html.LabelFor(m => m.Nombre)
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required", autocomplete = "off", placeholder = "Cómputo" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Abreviatura, "Abreviatura")
        @Html.TextBoxFor(m => m.Abreviatura, new { @class = "form-control mono", maxlength = "4", required = "required", autocomplete = "off", style = "max-width:8rem;text-transform:uppercase", placeholder = "COM" })
        <div class="form-text">
            2 a 4 letras. Es la primera parte del código automático de los activos
            (<code>COM</code> + <code>LEN</code> + fecha + consecutivo). No se puede repetir
            entre categorías, y cambiarla no afecta a los códigos ya generados.
        </div>
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Descripcion)
        @Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control", placeholder = "Equipo de cómputo" })
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
}
