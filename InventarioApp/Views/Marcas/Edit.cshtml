@model InventarioApp.Models.Marca
@{ ViewBag.Title = "Editar Marca"; }

<h2>Editar Marca</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="mb-3">@Html.LabelFor(m => m.Nombre) @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })</div>
    <div class="mb-3">@Html.LabelFor(m => m.Descripcion) @Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control" })</div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Abreviatura, "Abreviatura")
        @*  text-transform es solo visual: el valor que viaja sigue siendo lo
            tecleado. Quien lo pasa a mayusculas de verdad es pkg_marcas, con
            UPPER(TRIM(...)) al guardar. Esto solo evita la sorpresa de escribir
            "len" y que despues aparezca "LEN". *@
        @Html.TextBoxFor(m => m.Abreviatura, new { @class = "form-control mono", maxlength = "4", style = "max-width:8rem;text-transform:uppercase", autocomplete = "off" })
        <div class="form-text">
            2 a 4 letras. Es la parte de esta marca dentro del código automático de los
            activos (ej. <code>LEN</code> para Lenovo). No se puede repetir entre marcas,
            y cambiarla no afecta a los códigos ya generados.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
}